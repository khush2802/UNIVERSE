# Copy to .env.local for development.

# Show development fixtures.
#   unset  -> shown in dev, hidden in a production build
#   false  -> hidden in both. Set this to preview exactly what deploys.
#   true   -> shown in both. Never commit this value.
NEXT_PUBLIC_SHOW_FIXTURES=

# --- Added in later chunks -------------------------------------------
# DATABASE_URL=            # chunk 12
# GITHUB_TOKEN=            # chunk 13, raises the API rate limit
# ANTHROPIC_API_KEY=       # chunk 15
# OWNER_PASSWORD_HASH=     # chunk 16
